{
  "definitions": {
    "layout": {
      "element": "div.todoapp",
      "attrs": ["class", "id"],
      "children": [
        {
          "oneOf": [
            "$core-interface",
            "$list"
          ]
        }
      ]
    },
    "core-interface": {
      "element": "header.header",
      "attrs": ["class"],
      "children": ["h1", "div"]
    },
    "list": {
      "element": "ul.todo-list",
      "attrs": ["class", "id"],
      "children": ["li"]
    },
    "footer": {
      "element": "footer.footer",
      "attrs": ["class"],
      "children": ["span", "ul", "button"]
    }
  },
  "nodes": {
    "body": {
      "attrs": [],
      "children": ["div", "$layout"]
    },
    "div": {
      "attrs": ["class", "id"],
      "children": ["$core-interface", "$list", "$footer", "div", "header", "ul", "footer", "input", "textarea", "button"]
    },
    "header": {
      "attrs": ["class"],
      "children": ["h1", "div"]
    },
    "h1": {
      "attrs": [],
      "children": ["#text"]
    },
    "input": {
      "attrs": ["class", "type", "placeholder", "value", "checked", "autofocus", "data-node-id"],
      "events": ["keydown", "change", "blur"],
      "children": []
    },
    "textarea": {
      "attrs": ["class", "data-node-id", "rows"],
      "events": ["keydown", "blur"],
      "children": ["#text"]
    },
    "button": {
      "attrs": ["class", "data-node-id"],
      "events": ["click"],
      "children": ["#text"]
    },
    "ul": {
      "attrs": ["class", "id"],
      "children": ["li"]
    },
    "li": {
      "attrs": ["class", "data-id", "data-index", "data-node-id", "draggable"],
      "events": ["dragstart", "dragover", "drop"],
      "children": ["span", "input", "textarea", "label", "button", "a"]
    },
    "label": {
      "attrs": ["data-node-id"],
      "events": ["dblclick"],
      "children": ["#text"]
    },
    "footer": {
      "attrs": ["class"],
      "children": ["span", "ul", "button"]
    },
    "span": {
      "attrs": ["class", "data-node-id", "title"],
      "children": ["strong", "#text"]
    },
    "strong": {
      "attrs": [],
      "children": ["#text"]
    },
    "a": {
      "attrs": ["class", "data-node-id"],
      "events": ["click"],
      "children": ["#text"]
    }
  },
  "urls": false,
  "maxDepth": 10,
  "limits": {
    "maxTextLength": 200,
    "maxAttributeNameLength": 64,
    "maxAttributeValueLength": 200,
    "maxAttributes": 8,
    "maxNodes": 300
  },
  "gas": {
    "enabled": true,
    "tank": {
      "init": 120000,
      "idle": 60000,
      "event": 30000
    },
    "refill": 5000,
    "costs": {
      "createElement": 4,
      "createTextNode": 4,
      "appendChild": 2,
      "insertBefore": 3,
      "removeChild": 2,
      "replaceChildren": 4,
      "setTextContent": { "base": 2, "perChar": 1, "charUnit": 64 },
      "setInnerHTML": { "base": 8, "perNode": 3, "perChar": 1, "charUnit": 128 },
      "setAttribute": { "base": 3, "perChar": 1, "charUnit": 64 },
      "removeAttribute": 1,
      "setStyle": { "base": 3, "perChar": 1, "charUnit": 64 },
      "addEventListener": 2,
      "eventTarget": 1,
      "eventPayload": { "base": 2, "perChar": 1, "charUnit": 64 }
    }
  },
  "content": {
    "rejectPattern": "[<>]"
  }
}
