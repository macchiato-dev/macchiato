{
  "nodes": {
    "body": {
      "attrs": [],
      "children": ["div"]
    },
    "div": {
      "attrs": ["class", "id"],
      "children": ["div", "header", "ul", "footer", "input", "button"]
    },
    "header": {
      "attrs": ["class"],
      "children": ["h1", "div"]
    },
    "h1": {
      "attrs": [],
      "children": ["#text"]
    },
    "input": {
      "attrs": ["class", "type", "placeholder", "value", "checked", "autofocus", "data-node-id", "data-events"],
      "children": []
    },
    "button": {
      "attrs": ["class", "data-node-id", "data-events"],
      "children": ["#text"]
    },
    "ul": {
      "attrs": ["class", "id"],
      "children": ["li"]
    },
    "li": {
      "attrs": ["class", "data-id", "data-index", "data-node-id", "data-events", "draggable"],
      "children": ["span", "input", "label", "button", "a"]
    },
    "label": {
      "attrs": ["data-node-id", "data-events"],
      "children": ["#text"]
    },
    "footer": {
      "attrs": ["class"],
      "children": ["span", "ul", "button"]
    },
    "span": {
      "attrs": ["class", "data-node-id", "data-events", "title"],
      "children": ["strong", "#text"]
    },
    "strong": {
      "attrs": [],
      "children": ["#text"]
    },
    "a": {
      "attrs": ["class", "data-node-id", "data-events"],
      "children": ["#text"]
    }
  },
  "urls": false,
  "maxDepth": 10,
  "limits": {
    "maxTextLength": 200,
    "maxAttributeNameLength": 64,
    "maxAttributeValueLength": 200,
    "maxAttributes": 8,
    "maxNodes": 300
  },
  "content": {
    "rejectPattern": "[<>]"
  }
}
