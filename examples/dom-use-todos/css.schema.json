{
  "values": {
    "color": {
      "pattern": "^(#[0-9A-Fa-f]{3,8}|rgba?\\(\\s*\\d{1,3}\\s*,\\s*\\d{1,3}\\s*,\\s*\\d{1,3}(?:\\s*,\\s*(?:0|1|0?\\.\\d+))?\\s*\\)|var\\(--[a-z0-9-]+\\)|inherit|transparent|currentColor)$"
    },
    "background": {
      "pattern": "^(var\\(--[a-z0-9-]+\\)|none|currentColor|transparent|#[0-9A-Fa-f]{3,8}|rgba?\\([0-9.,\\s]+\\)|(?:(?:radial|linear)-gradient\\([A-Za-z0-9#.,%\\s()+\\-/]+\\)(?:,\\s*)?)+)$"
    },
    "length": {
      "pattern": "^(0|auto|-?\\d+(?:\\.\\d+)?(?:px|rem|em|%|vw|vh|ch)|clamp\\([A-Za-z0-9#.,%\\s()+\\-/]+\\)|min\\([A-Za-z0-9#.,%\\s()+\\-/]+\\)|max\\([A-Za-z0-9#.,%\\s()+\\-/]+\\)|calc\\([A-Za-z0-9#.,%\\s()+\\-/]+\\)|var\\(--[a-z0-9-]+\\))$"
    },
    "spacing": {
      "pattern": "^(?:0|auto|-?\\d+(?:\\.\\d+)?(?:px|rem|em|%|vw|vh|ch)|clamp\\([A-Za-z0-9#.,%\\s()+\\-/]+\\)|var\\(--[a-z0-9-]+\\))(?:\\s+(?:0|auto|-?\\d+(?:\\.\\d+)?(?:px|rem|em|%|vw|vh|ch)|clamp\\([A-Za-z0-9#.,%\\s()+\\-/]+\\)|var\\(--[a-z0-9-]+\\))){0,3}$"
    },
    "border": {
      "pattern": "^(none|\\d+(?:\\.\\d+)?px\\s+(?:solid|dashed|dotted)\\s+(?:#[0-9A-Fa-f]{3,8}|rgba?\\([0-9.,\\s]+\\)|var\\(--[a-z0-9-]+\\)|transparent))$"
    },
    "radius": {
      "pattern": "^(0|50%|999px|var\\(--[a-z0-9-]+\\)|\\d+(?:\\.\\d+)?(?:px|rem|%))(?:\\s+(?:0|50%|999px|var\\(--[a-z0-9-]+\\)|\\d+(?:\\.\\d+)?(?:px|rem|%))){0,3}$"
    },
    "shadow": {
      "pattern": "^(none|var\\(--[a-z0-9-]+\\)|(?:inset\\s+)?(?:0|-?\\d+(?:\\.\\d+)?px)\\s+(?:0|-?\\d+(?:\\.\\d+)?px)(?:\\s+(?:0|-?\\d+(?:\\.\\d+)?px)){0,2}\\s+(?:#[0-9A-Fa-f]{3,8}|rgba?\\([0-9.,\\s]+\\))(?:,\\s*(?:inset\\s+)?(?:0|-?\\d+(?:\\.\\d+)?px)\\s+(?:0|-?\\d+(?:\\.\\d+)?px)(?:\\s+(?:0|-?\\d+(?:\\.\\d+)?px)){0,2}\\s+(?:#[0-9A-Fa-f]{3,8}|rgba?\\([0-9.,\\s]+\\)))*)$"
    },
    "fontFamily": {
      "pattern": "^(['\"]?[A-Za-z0-9 -]+['\"]?)(?:,\\s*[-A-Za-z0-9 '\"]+)*$"
    },
    "fontWeight": {
      "pattern": "^(normal|bold|[1-9]00)$"
    },
    "number": {
      "pattern": "^(0|1|0?\\.\\d+)$"
    },
    "integer": {
      "pattern": "^-?\\d+$"
    },
    "display": {
      "enum": [
        "block",
        "flex",
        "grid",
        "inline-flex",
        "none",
        "none !important"
      ]
    },
    "flex": {
      "pattern": "^(none|1|0\\s+0\\s+auto|\\d+(?:\\s+\\d+)?(?:\\s+(?:auto|0|\\d+px|\\d+%))?)$"
    },
    "gridArea": {
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "gridTracks": {
      "pattern": "^([a-z0-9.,%\\s()+\\-/]+|var\\(--[a-z0-9-]+\\))+$"
    },
    "gridAreas": {
      "pattern": "^\"[a-z0-9\\s.-]+\"(?:\\s+\"[a-z0-9\\s.-]+\")*$"
    },
    "align": {
      "enum": [
        "start",
        "end",
        "center",
        "baseline",
        "stretch",
        "flex-start",
        "flex-end",
        "space-between"
      ]
    },
    "cursor": {
      "enum": [
        "default",
        "pointer",
        "text",
        "grab",
        "grabbing"
      ]
    },
    "position": {
      "enum": [
        "relative",
        "absolute",
        "fixed",
        "sticky",
        "static"
      ]
    },
    "transform": {
      "pattern": "^(none|(?:translate(?:X|Y)?|rotate|scale)\\([A-Za-z0-9.,%\\s()+\\-]+\\)(?:\\s+(?:translate(?:X|Y)?|rotate|scale)\\([A-Za-z0-9.,%\\s()+\\-]+\\))*)$"
    },
    "transition": {
      "pattern": "^[a-z-]+\\s+(?:\\d+(?:\\.\\d+)?|\\.\\d+)s(?:\\s+(?:ease|linear|ease-in|ease-out|ease-in-out|cubic-bezier\\([0-9.,\\s]+\\)))?(?:\\s+(?:\\d+(?:\\.\\d+)?|\\.\\d+)s)?(?:,\\s*[a-z-]+\\s+(?:\\d+(?:\\.\\d+)?|\\.\\d+)s(?:\\s+(?:ease|linear|ease-in|ease-out|ease-in-out|cubic-bezier\\([0-9.,\\s]+\\)))?(?:\\s+(?:\\d+(?:\\.\\d+)?|\\.\\d+)s)?)*$"
    },
    "animation": {
      "pattern": "^[a-zA-Z0-9_-]+\\s+(?:\\d+(?:\\.\\d+)?|\\.\\d+)s\\s+(?:ease|linear|ease-in|ease-out|ease-in-out)(?:\\s+(?:both|forwards|backwards|infinite|\\d+)){0,2}$"
    },
    "time": {
      "pattern": "^(?:\\d+(?:\\.\\d+)?|\\.\\d+)s$"
    },
    "fontSize": {
      "$ref": "length"
    },
    "lineHeight": {
      "pattern": "^(normal|\\d+(?:\\.\\d+)?|\\d+(?:\\.\\d+)?(?:px|rem|em|%))$"
    },
    "letterSpacing": {
      "pattern": "^-?\\d+(?:\\.\\d+)?(?:px|em|rem)$"
    },
    "textDecoration": {
      "enum": [
        "none",
        "underline",
        "line-through"
      ]
    },
    "textTransform": {
      "enum": [
        "none",
        "uppercase",
        "lowercase",
        "capitalize"
      ]
    },
    "boolNone": {
      "enum": [
        "none"
      ]
    },
    "fontFaceSrc": {
      "pattern": "^url\\(\"/-/fonts/resourcesco-space-grotesk/space-grotesk-(?:latin|latin-ext|vietnamese)\\.woff2\"\\) format\\('woff2'\\)$"
    },
    "unicodeRange": {
      "pattern": "^U\\+[0-9A-F?]{2,6}(?:-[0-9A-F]{2,6})?(?:,\\s*U\\+[0-9A-F?]{2,6}(?:-[0-9A-F]{2,6})?)*$"
    },
    "filter": {
      "pattern": "^(?:blur\\(\\d+(?:\\.\\d+)?px\\)|saturate\\(\\d+%\\))(?:\\s+(?:blur\\(\\d+(?:\\.\\d+)?px\\)|saturate\\(\\d+%\\)))*$"
    },
    "todoBackground": {
      "anyOf": [
        {
          "$ref": "color"
        },
        {
          "enum": [
            "none"
          ]
        }
      ]
    },
    "todoBorder": {
      "anyOf": [
        {
          "$ref": "border"
        },
        {
          "pattern": "^solid\\s+#[0-9A-Fa-f]{3,8}$"
        }
      ]
    },
    "todoContent": {
      "enum": [
        "''",
        "\"\""
      ]
    }
  },
  "definitions": {
