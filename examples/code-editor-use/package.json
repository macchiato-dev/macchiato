{
  "name": "@macchiato-dev/example-code-editor-use",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reference application that chooses and configures a CodeMirror guest for code-editor-use",
  "scripts": {
    "start": "node ../../packages/app/src/index.js --host 127.0.0.1 --port 8765 --app-plugin code-editor-use",
    "test": "node --test ../../packages/app/test/code-editor-use.browser.test.js",
    "check:guest": "npm run check:guest -w @macchiato-dev/browser-use"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.18.7",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.38.1",
    "@macchiato-dev/app": "0.1.0",
    "@macchiato-dev/browser-use": "0.1.0",
    "@macchiato-dev/code-editor-use": "0.1.0",
    "@macchiato-dev/quickjs-emscripten-sandbox": "0.1.0",
    "@playwright/test": "^1.60.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.1"
  }
}
