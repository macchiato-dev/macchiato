{
  "nodes": {
    "main": {
      "attrs": ["class", "aria-label"],
      "children": ["h1"]
    },
    "h1": {
      "attrs": [],
      "children": ["#text", "span"]
    },
    "span": {
      "attrs": [],
      "children": ["#text"]
    }
  },
  "urls": false,
  "maxDepth": 5,
  "limits": {
    "maxTextLength": 80,
    "maxAttributeNameLength": 64,
    "maxAttributeValueLength": 120,
    "maxAttributes": 3,
    "maxNodes": 8
  },
  "content": {
    "rejectPattern": "[<>]"
  }
}
