{
  "definitions": {
    "layout": {
      "element": "main.layout",
      "attrs": ["class"],
      "children": [
        {
          "oneOf": [
            "$brand",
            "$userbar",
            "$main-column",
            "$primary-nav",
            "$site-footer"
          ]
        }
      ]
    },
    "brand": {
      "element": "header.box.brand",
      "attrs": ["class", "data-screen-label"],
      "children": ["nav"]
    },
    "userbar": {
      "element": "section.box.userbar",
      "attrs": ["class", "data-screen-label"],
      "children": ["$userbar-pop"]
    },
    "userbar-pop": {
      "element": "div.ub-pop",
      "attrs": ["class"],
      "children": ["button", "$popover-menu"]
    },
    "popover-menu": {
      "element": "div.popover.user-menu",
      "attrs": ["class", "role"],
      "children": ["button", "div"]
    },
    "main-column": {
      "element": "div.main",
      "attrs": ["class", "id"],
      "children": ["$content-root"]
    },
    "content-root": {
      "element": "div.content-root",
      "attrs": ["class", "id"],
      "children": ["$content-block"]
    },
    "content-block": {
      "element": "section.box.block",
      "attrs": ["class"],
      "children": ["div", "h1", "h2", "p"]
    },
    "items-block": {
      "element": "div.items",
      "attrs": ["class"],
      "children": ["a"]
    },
    "primary-nav": {
      "element": "nav.box.nav",
      "attrs": ["class", "data-screen-label", "aria-label"],
      "children": ["a", "div"]
    },
    "site-footer": {
      "element": "footer.box.footer",
      "attrs": ["class", "data-screen-label"],
      "children": ["div"]
    }
  },
  "nodes": {
    "a": {
      "attrs": ["class", "href", "data-section", "aria-current", "aria-label"],
      "children": ["div", "span", "#text"]
    },
    "button": {
      "attrs": ["id", "class", "role", "aria-checked", "aria-label", "aria-haspopup", "aria-expanded", "aria-pressed"],
      "children": ["#text", "span", "svg"]
    },
    "circle": {
      "attrs": ["cx", "cy", "r", "fill", "stroke"],
      "children": []
    },
    "div": {
      "attrs": ["class", "id", "role", "aria-label"],
      "children": ["#text", "a", "button", "div", "h1", "h2", "p", "section", "span"]
    },
    "footer": {
      "attrs": ["class", "data-screen-label"],
      "children": ["div"]
    },
    "h1": {
      "attrs": [],
      "children": ["#text"]
    },
    "h2": {
      "attrs": [],
      "children": ["#text"]
    },
    "header": {
      "attrs": ["class", "data-screen-label"],
      "children": ["nav"]
    },
    "line": {
      "attrs": ["x1", "x2", "y1", "y2"],
      "children": []
    },
    "main": {
      "attrs": ["class"],
      "children": [
        {
          "oneOf": [
            "$brand",
            "$userbar",
            "$main-column",
            "$primary-nav",
            "$site-footer"
          ]
        }
      ]
    },
    "nav": {
      "attrs": ["class", "id", "data-screen-label", "aria-label"],
      "children": ["a", "div"]
    },
    "p": {
      "attrs": [],
      "children": ["#text"]
    },
    "path": {
      "attrs": ["d"],
      "children": []
    },
    "section": {
      "attrs": ["class", "data-screen-label"],
      "children": ["button", "div", "h1", "h2", "p"]
    },
    "span": {
      "attrs": ["class"],
      "children": ["#text", "svg"]
    },
    "svg": {
      "attrs": ["class", "viewBox", "fill", "stroke", "stroke-width", "stroke-linecap", "stroke-linejoin"],
      "children": ["circle", "line", "path"]
    }
  },
  "urls": false,
  "maxDepth": 12,
  "limits": {
    "maxTextLength": 12000,
    "maxAttributeNameLength": 64,
    "maxAttributeValueLength": 260,
    "maxAttributes": 10,
    "maxNodes": 320
  },
  "content": {
    "rejectPattern": "<"
  }
}
