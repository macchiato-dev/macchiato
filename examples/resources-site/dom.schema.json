{
  "definitions": {
    "layout": {
      "element": "main.layout",
      "attrs": ["class"],
      "children": [
        {
          "oneOf": [
            "$brand",
            "$project-identity",
            "$theme-toggle-block",
            "$mobile-menu",
            "$main-column",
            "$primary-nav",
            "$site-footer"
          ]
        }
      ]
    },
    "brand": {
      "element": "header.box.brand",
      "attrs": ["class", "data-screen-label"],
      "children": ["nav"]
    },
    "project-identity": {
      "element": "header.box.project-identity",
      "attrs": ["class", "data-screen-label"],
      "children": ["nav"]
    },
    "theme-toggle-block": {
      "element": "section.box.toggle",
      "attrs": ["class", "data-screen-label"],
      "children": ["button"]
    },
    "mobile-menu": {
      "element": "section.box.menu",
      "attrs": ["class", "data-open", "data-screen-label"],
      "children": ["button", "div"]
    },
    "main-column": {
      "element": "div.main",
      "attrs": ["class", "id"],
      "children": [
        {
          "oneOf": [
            "$breadcrumb",
            "$content-root"
          ]
        }
      ]
    },
    "breadcrumb": {
      "element": "nav.box.crumb",
      "attrs": ["class", "id", "aria-label"],
      "children": ["a", "span"]
    },
    "content-root": {
      "element": "div.content-root",
      "attrs": ["class", "id"],
      "children": [
        {
          "oneOf": [
            "$content-block",
            "$project-summary-block",
            "$package-details-block"
          ]
        }
      ]
    },
    "content-block": {
      "element": "section.box.block.content-block",
      "attrs": ["class"],
      "children": ["div", "h1", "h2", "p"]
    },
    "project-summary-block": {
      "element": "section.box.block.project-summary",
      "attrs": ["class"],
      "children": ["div"]
    },
    "package-details-block": {
      "element": "section.box.block.package-details",
      "attrs": ["class"],
      "children": ["div", "h1", "h2", "p"]
    },
    "items-block": {
      "element": "div.items",
      "attrs": ["class"],
      "children": ["a", "span"]
    },
    "tags-block": {
      "element": "div.tags",
      "attrs": ["class"],
      "children": ["span"]
    },
    "primary-nav": {
      "element": "nav.box.nav",
      "attrs": ["class", "data-screen-label", "aria-label"],
      "children": ["a"]
    },
    "menu-panel": {
      "element": "div.box.menu-panel",
      "attrs": ["class"],
      "children": ["button", "nav"]
    },
    "menu-nav": {
      "element": "nav.menu-nav",
      "attrs": ["class", "aria-label"],
      "children": ["a"]
    },
    "site-footer": {
      "element": "footer.box.footer",
      "attrs": ["class", "data-screen-label"],
      "children": ["div"]
    },
    "language-form": {
      "element": "form.language-switcher",
      "attrs": ["class", "method", "action"],
      "children": ["label", "input", "button"]
    },
    "client-script": {
      "element": "script",
      "attrs": [],
      "children": ["#text"]
    }
  },
  "nodes": {
    "a": {
      "attrs": ["class", "aria-current", "aria-label", "href", "data-section"],
      "children": ["#text", "div", "span", "svg"]
    },
    "button": {
      "attrs": ["class", "type", "role", "aria-checked", "aria-expanded", "aria-label", "aria-haspopup"],
      "children": ["#text", "span", "svg"]
    },
    "circle": {
      "attrs": ["cx", "cy", "r", "fill", "stroke"],
      "children": []
    },
    "div": {
      "attrs": ["class", "id", "role", "aria-label"],
      "children": ["#text", "a", "button", "div", "form", "h1", "h2", "nav", "p", "section", "span"]
    },
    "form": {
      "attrs": ["class", "method", "action"],
      "children": ["label", "input", "button"]
    },
    "footer": {
      "attrs": ["class", "data-screen-label"],
      "children": ["div"]
    },
    "h1": {
      "attrs": [],
      "children": ["#text"]
    },
    "h2": {
      "attrs": [],
      "children": ["#text"]
    },
    "input": {
      "attrs": ["type", "name", "value"],
      "children": []
    },
    "iframe": {
      "attrs": ["class", "src", "title", "loading", "referrerpolicy", "sandbox"],
      "children": []
    },
    "label": {
      "attrs": ["class"],
      "children": ["#text", "select", "span"]
    },
    "option": {
      "attrs": ["value", "selected"],
      "children": ["#text"]
    },
    "header": {
      "attrs": ["class", "data-screen-label"],
      "children": ["nav"]
    },
    "line": {
      "attrs": ["x1", "x2", "y1", "y2"],
      "children": []
    },
    "main": {
      "attrs": ["class"],
      "children": [
        {
          "oneOf": [
            "$brand",
            "$project-identity",
            "$theme-toggle-block",
            "$mobile-menu",
            "$main-column",
            "$primary-nav",
            "$site-footer"
          ]
        }
      ]
    },
    "nav": {
      "attrs": ["class", "id", "aria-label", "data-screen-label"],
      "children": ["a", "span"]
    },
    "p": {
      "attrs": [],
      "children": ["#text", "a"]
    },
    "path": {
      "attrs": ["d", "fill"],
      "children": []
    },
    "script": {
      "attrs": [],
      "children": ["#text"]
    },
    "section": {
      "attrs": ["class", "data-open", "data-screen-label"],
      "children": ["button", "div", "h1", "h2", "iframe", "p"]
    },
    "select": {
      "attrs": ["name", "aria-label"],
      "children": ["option"]
    },
    "span": {
      "attrs": ["class"],
      "children": ["#text", "svg"]
    },
    "svg": {
      "attrs": ["class", "viewBox", "fill", "stroke", "stroke-width", "stroke-linecap", "stroke-linejoin"],
      "children": ["circle", "line", "path"]
    }
  },
  "urls": {
    "href": "^(?:/(?:[A-Za-z0-9._~-]+/?)*|https://[A-Za-z0-9.-]+(?::[0-9]+)?(?:/[^\\s<>\"]*)?)$",
    "src": "^(?:https://codesandbox\\.io/embed/[A-Za-z0-9._~?&=/%+-]+|/-/blog-examples/[A-Za-z0-9._~?&=/%+-]+)$",
    "action": "^/language$"
  },
  "maxDepth": 12,
  "limits": {
    "maxTextLength": 12000,
    "maxAttributeNameLength": 64,
    "maxAttributeValueLength": 1600,
    "maxAttributes": 10,
    "maxNodes": 260
  },
  "content": {
    "rejectPattern": "<"
  }
}
