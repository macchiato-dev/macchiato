{
  "name": "@macchiato-dev/browser-use",
  "version": "0.1.0",
  "type": "module",
  "description": "Policy-bound live browser DOM handles and shape detection",
  "scripts": {
    "build:guest": "node scripts/sync-quickjs-dom-guest.js --write",
    "check:guest": "node scripts/sync-quickjs-dom-guest.js --check"
