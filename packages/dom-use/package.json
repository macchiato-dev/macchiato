{
  "name": "@macchiato-dev/dom-use",
  "version": "0.1.0",
  "description": "Structured DOM access according to a schema — the top-level capability",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macchiato-dev/macchiato.git",
    "directory": "packages/dom-use"
  },
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./bridge": "./lib/bridge.js",
    "./guest-runtime": "./lib/guest-runtime.js",
    "./guest-runtime-microquickjs": "./lib/guest-runtime-microquickjs.js",
    "./host": {
      "types": "./lib/host.d.ts",
      "default": "./lib/host.js"
    },
    "./browser-assets": "./lib/browser-assets.js"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "examples",
    "README.md",
    "tsconfig.json",
    "babel.microquickjs.json",
    "deno.json"
  ],
  "sideEffects": [
    "./lib/guest-runtime.js",
    "./lib/guest-runtime-microquickjs.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json && node scripts/build-guest.js",
    "lint": "deno lint --config deno.json",
    "deno-check": "deno check src/*.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run lint && npm run deno-check && npm run typecheck && npm run build && npm run test:unit",
    "bench": "npm run build && node --expose-gc bench/performance.js",
    "prepack": "npm run build",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --test test/*.test.js"
  },
  "dependencies": {
    "@macchiato-dev/html-use": "0.1.0",
    "@macchiato-dev/style-use": "0.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  }
}
