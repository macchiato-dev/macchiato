±àfunction destructivePatch(patch) {
    return patch.files.some((operation) => operation.op === "delete") || patch.config.length > 0;
  }B␀␀␀␀␀␀÷␀␀œ=≤␀␀	␀␀␀©(¸	£	4((operation) => operation.op === "delete"C␀“␀␀␀Wƒ	␀␀ ␀“␀␀–␀8␀␀>à␀␀8␀œ=,␀␀ÌI,␀␀8␀œ=`␀␀ÌI`␀␀8␀œ=:␀␀␀ÌI:␀␀␀8␀œ=˘␀␀ÌI˘␀␀8␀œ=Ô␀␀ÌI␀␀%␀¸3•	!!!!!␀	%Ìfunction organization(row) {
