  // packages/hub/src/url-pattern.js
  var HOST_LABEL = /^(?:\*|[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)$/i;
  function wildcardSource(value, { dotAware = false } = {}) {
