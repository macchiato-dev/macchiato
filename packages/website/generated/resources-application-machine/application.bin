åfunction slug(value) {
    const result = text(value, "slug", { min: 1, max: 63 }).toLowerCase();
    if (!SLUG.test(result)) {
      throw new ContentValidationError("slug", "name must use lowercase letters, numbers, and single hyphens");
    }
    return result;
  }C␀¬␀␀$‰␀␀“␀␀Ω␀Ω4>N␀␀8␀␀œÆËÍ=6␀␀␀ÈœÌ%␀¸¯:
