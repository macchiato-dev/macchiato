        try {
          const result = await client.execute({
            sql: ORGANIZATION_QUERIES.changeRole,
            args: [role(requestedRole), now(), org.id, String(memberUserId)]
          });
          return Boolean(result.rowsAffected);
        } catch (error) {
          throw invitationConflict(error) || error;
