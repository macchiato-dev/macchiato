                VALUES (?, ?, ?, ?, ?)`,
    insertInitialLabel: `INSERT INTO resource_project_version_labels (project_id, sequence, title, saved_at)
                VALUES (?, 1, '', ?)`,
    insertPublication: `INSERT INTO resource_project_publications (project_id, snapshot_json, published_at)
