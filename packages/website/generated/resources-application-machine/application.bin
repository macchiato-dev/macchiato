      const account = session && pathname === "/profile" ? await accounts2.getAccount(session.sub) : null;
      const publicProjects = pathname === "/" && !session || pathname === "/browse" ? await content2.listPublicProjects({
        limit: pathname === "/" ? 6 : 48,
