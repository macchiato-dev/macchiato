      this.name = "AccountConflictError";
      this.code = code;
      this.providers = Object.freeze([...providers]);
    }
  }∆␀␀␀␀␀FÓ␀␀Ï␀␀␀ ˆ␀«»^␀+√5ƒS␀␀!␀b␀d␀␀Ë_␀$␀␀_␀5␀␀?:␀␀␀_␀T␀␀?L␀␀c␀(¸Ú5*
