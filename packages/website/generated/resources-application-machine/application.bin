µ˙function parsedPatch(value) {
    const patch = JSON.parse(String(value));
    if (!patch || patch.version !== 1 || !Array.isArray(patch.files) || !Array.isArray(patch.config)) throw new Error("Stored project patch is invalid");
    return patch;
