;5!␀à›ífunction createContentStore(client, {
    now = Date.now,
    randomId = () => crypto.randomUUID(),
    versionPlanner = planProjectVersionUpdate,
    snapshotDiffer = diffProjectSnapshots,
    snapshotValidator = async () => {
    }
