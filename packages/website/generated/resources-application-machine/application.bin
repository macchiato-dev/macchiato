      code: typeof error?.code === "string" ? error.code : "",
      field: typeof error?.field === "string" ? error.field : "",
      providers: Array.isArray(error?.providers) ? [...error.providers] : []
    };
  }b␀Ü␀	␀ú¶␀␀‰␀␀‰	␀␀®␀␀∞™␀∞‰␀É˙T␀␀¸U␀␀˛V␀␀Ã␀à[␀␀˙␀ÙQ␀␀ˆR␀␀ÑY␀␀^␀^␀␀€I≠␀␀‹I~␀␀›Ih␀␀«_␀␀œC»_␀îÈ_␀–Cï␀␀␀™È8␀>␀␀—$␀îË32␀␀ß␀␀␀I:␀␀␀÷␀␀I6␀␀␀øIP␀␀øIF␀␀&␀␀IQ␀␀&␀/ky␀␀␀[␀Ïâ8␀(␀␀C␀␀&␀␀Ôâ\␀–m␀␀©Èœ~␀␀©Ë!–*␀␀©Ë8␀◊␀␀ÿ␀␀&␀␀Ôâ&␀Í&␀␀\␀û␀␀␀_␀–D&␀␀≥—O'␀␀â&␀nl%␀␀␀/…k␀␀␀2␀␀[␀≈Ì&␀nl␀␀␀/l␀␀␀0&␀␀\␀m/¸Y£&8>B [* 9&
