        const snapshot = await this.getProjectVersion(projectId, sequence, userId);
        if (!snapshot) return null;
        return this.saveProjectSnapshot(userId, projectId, snapshot, { reason: "restore", destructive: true });
      }`␀␀␀␀—¸	␀␀ú␀␀␀␀␀¸	ˇˇˇˇ␀†ú␀†Ã␀†¥␀†¥␀␀␀Ã␀␀˛	␀∞å␀∞Ä␀∞¥␀∞¶
