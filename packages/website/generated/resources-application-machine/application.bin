*Y÷function normalizeEmail(value) {
    const email = String(value || "").trim();
    const separator = email.lastIndexOf("@");
    if (separator < 1 || separator === email.length - 1 || email.length > 254) {
      throw new Error("A verified provider email address is required");
    }
    return { email, normalized: email.toLowerCase() };
  }C␀Ù␀␀␀␀¿␀␀œÆËÍ=j␀␀ÆËÍ≥CÈ(¯°p %Efunction firstRow(result) {
    return result?.rows?.[0] || null;
  }C␀ˆ␀␀␀?÷	␀␀ ␀“␀␀œË;8␀␀>á␀␀8␀œ=*␀␀ÌI*␀␀8␀œ=l␀␀ÌIè␀␀8␀œ=m␀␀ÌI:␀␀␀$␀(¯'§!!!␀5Æfunction accountFromRow(row) {
    return row && Object.freeze({
      id: String(row.id),
      login: String(row.username),
      name: String(row.display_name)
    });
  }A␀¯ë‹	@␀␀␀‹	ˇˇˇˇ␀†ú	␀†û	␀†ﬁ	␀†ﬁ	␀␀␀û	@ú	@∏	‡	␀‡‚	@¿
