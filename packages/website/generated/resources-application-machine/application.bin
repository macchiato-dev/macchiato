      return initialized2;
    }B␀␀␀␀␀␀¯	␀␀œI|␀␀&␀␀I}␀␀(¯¸<(sql) => ({ sql, args: [] })B␀␀␀␀␀‡␀␀‡	␀␀e␀␀œ0¯
