3Jãasync function serverHandle(input) {
    if (!Array.isArray(input)) {
      return ["error", "unknown application operation"];
    }
    if (input[0] === "initialize") {
      await initialize();
      return ["ok"];
    }
    if (input[0] === "store" && input.length === 4) {
      return storeCall(input[1], input[2], input[3]);
    }
    return ["error", "unknown application operation"];
  }