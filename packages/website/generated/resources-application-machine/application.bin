␀e%$>D+k(*.*␀«£!async function planDocument2(input) {
      if (!input || typeof input !== "object" || typeof input.pathname !== "string") {
        throw new TypeError("Document plan input is invalid");
      }
      if (input.routeOnly === true) {
        const direct = /^\/try\/([a-z0-9]+(?:-[a-z0-9]+)*)$/.exec(input.pathname)?.[1] || "";
        if (direct) return tryTemplates.has(direct) ? { directTryTemplate: direct } : { notFound: true };
        if ((input.method === "GET" || input.method === "HEAD") && input.pathname === "/try" && typeof input.template === "string") {
          return tryTemplates.has(input.template) ? { redirect: `/try/${input.template}` } : { notFound: true };
        }
        return { directTryTemplate: "" };
      }
      const directTryTemplate = typeof input.directTryTemplate === "string" ? input.directTryTemplate : "";
      const session = input.session && typeof input.session.sub === "string" ? input.session : null;
      const accountShellPath = directTryTemplate ? "/try" : input.pathname === "/" && session || input.pathname === "/profile" ? "/dashboard" : input.pathname;
      if (input.shellOnly === true) return { accountShellPath };
      if (input.publicApi === true) {
        return { publicProjects: await content2.listPublicProjects({
          limit: 6,
          namespaces: discoverableNamespaces
        }) };
      }
      const pathname = input.pathname;
      const requestedProject = directTryTemplate ? null : projectRoute(pathname);
      const requestedNamespace = requestedProject ? null : namespaceRoute(pathname);
      const dynamicProject = requestedProject ? await content2.getProject(requestedProject.namespace, requestedProject.slug, session?.sub) : null;
      const projectOwner = Boolean(dynamicProject && session && dynamicProject.ownerUserId === session.sub);
      const dynamicNamespace = !input.staticShellExists && requestedNamespace ? await content2.getNamespace(requestedNamespace, session?.sub) : null;
      const managedOrganization = dynamicNamespace?.kind === "organization" && session ? await organizations2.getManagedOrganization(dynamicNamespace.namespace, session.sub) : null;
      const accountContent = projectOwner || session && accountPaths.has(pathname) ? await content2.listForUser(session.sub) : null;
      const account = session && pathname === "/profile" ? await accounts2.getAccount(session.sub) : null;
      const publicProjects = pathname === "/" && !session || pathname === "/browse" ? await content2.listPublicProjects({
        limit: pathname === "/" ? 6 : 48,
        namespaces: discoverableNamespaces
      }) : null;
      const notifications = session ? await organizations2.listNotifications(session.sub) : [];
      let kind = "static";
      if (dynamicProject) kind = "project";
      else if (dynamicNamespace) kind = managedOrganization ? "managed-organization" : "namespace";
      else if (pathname === "/try" || directTryTemplate) kind = "try";
      else if (session && accountPaths.has(pathname)) {
        kind = pathname === "/" ? "dashboard" : pathname === "/projects" ? "projects" : pathname === "/projects/new" ? "project-form" : pathname === "/organizations/new" ? "organization-form" : "profile";
      }
      const csrfActions = [];
      if (projectOwner) csrfActions.push(`project:${dynamicProject.id}`);
      else if (managedOrganization) csrfActions.push(`organization:${managedOrganization.slug}`);
      else if (session && kind === "project-form") csrfActions.push("/projects");
      else if (session && kind === "organization-form") csrfActions.push("/organizations");
      else if (session && kind === "profile") csrfActions.push("profile");
      if (session) csrfActions.push("notifications");
      return {
        requestedProject,
        dynamicProject,
        projectOwner,
        dynamicNamespace,
        managedOrganization,
        accountContent,
        account,
        publicProjects,
        notifications,
        kind,
        csrfActions,
        accountShellPath,
        shellPath: dynamicProject || dynamicNamespace ? "/dashboard" : accountShellPath,
        focused: Boolean(dynamicProject) || pathname === "/projects/new" || pathname === "/try" || Boolean(directTryTemplate)
      };
    }F^\/try\/([a-z0-9]+(?:-[a-z0-9]+)*)$¥␀␀␀R␀␀␀␀␀␀ıˇˇˇ␀	/␀t␀r␀y␀/␀$␀0␀9␀a␀z␀ˇˇˇ␀␀␀-␀$␀0␀9␀a␀z␀ˇˇˇ„ˇˇˇ␀B␀␀␀Ç	à␀␀ú␀␀∞d␀†û␀∞†␀∞î␀∞ñ␀†û␀∞†␀†“␀␀␀^␀^␀^␀^␀␀8␀␀œÌ«≥»^␀_␀␀{Í@…^␀_␀>—␀␀≥$␀ _␀_␀ºÄ␀°Ë¥Í_␀º␀°ËµÍ_␀␀␀␀°Ë∂Í∑õ`␀~␀ËæÇ8␀_␀!␀¡≥¡^␀_␀␀{Î¸␀¡^␀_␀>—␀␀≥$␀¡_␀␀ÿ␀␀§Ë_␀ˇﬂ␀␀¢Ë	˝ˇ␀␀`␀_␀ºÄ␀°Ë_␀_␀è`␀_␀FÎ±␀_␀º␀°Ë,_␀_␀è`␀º¿␀_␀πü≠F_␀_␀è`␀ºÄ␀_␀ª?´≠FÍ|_␀␀␀␀§Ë0_␀_␀è`␀º␀_␀ªü≠F_␀_␀è`␀ºÄ␀_␀ªüª?´≠FÍ_␀_␀è`␀º‡␀_␀ªü≠F_␀_␀è`␀ºÄ␀_␀πüª?´≠F_␀_␀è`␀ºÄ␀_␀ª?´≠F~␀hˇˇˇÇ_␀(¸√‘? 5 -    *%[6	"? -**+C &+ #*#1
#<„encode(value) {
        const text2 = String(value);
        let length = 0;
        for (const character of text2) {
          const point = character.codePointAt(0);
          length += point < 128 ? 1 : point < 2048 ? 2 : point < 65536 ? 3 : 4;
        }
        const bytes = new Uint8Array(length);
        let at = 0;
        for (const character of text2) {
          let point = character.codePointAt(0);
          if (point >= 55296 && point <= 57343) point = 65533;
          if (point < 128) bytes[at++] = point;
          else if (point < 2048) {
            bytes[at++] = 192 | point >> 6;
            bytes[at++] = 128 | point & 63;
          } else {
            if (point >= 65536) {
              bytes[at++] = 240 | point >> 18;
              bytes[at++] = 128 | point >> 12 & 63;
            } else bytes[at++] = 224 | point >> 12;
            bytes[at++] = 128 | point >> 6 & 63;
            bytes[at++] = 128 | point & 63;
          }
        }
        return bytes;
