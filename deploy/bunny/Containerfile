# Key-bearing Bunny deployment image. Build context: the output directory of
# scripts/build-resources-bunny.js, which holds this file, the compiled deploy
# client, and the verified release. Nothing is built or served in this image.
FROM registry.fedoraproject.org/fedora-minimal:43
COPY --chmod=0555 bunny-deploy /usr/local/bin/bunny-deploy
COPY release /release
USER 65534:65534
ENTRYPOINT ["/usr/local/bin/bunny-deploy"]
CMD ["/release"]
